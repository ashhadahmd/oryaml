from typing import Any, Optional, Protocol, Union, overload

class _BinaryWriter(Protocol):
    def write(self, data: bytes, /) -> Any: ...

def loads(input_data: Union[str, bytes], /) -> Any: ...
@overload
def dumps(data: Any, stream: None = None) -> bytes: ...
@overload
def dumps(data: Any, stream: Union[str, _BinaryWriter]) -> None: ...
